<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console test runner, so no NuGet test framework is needed. Run it with: dotnet run, from this folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Chat.Server\Chat.Server.csproj" />
    <ProjectReference Include="..\..\src\Chat.Client\Chat.Client.csproj" />
  </ItemGroup>
</Project>
