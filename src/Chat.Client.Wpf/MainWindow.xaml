<Window x:Class="Chat.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat" Height="560" Width="820" Closing="Window_Closing">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" BorderBrush="#ccd2d8" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Sensor node: " FontWeight="Bold" />
                <TextBlock x:Name="SensorText" Text="no reading yet" />
            </StackPanel>
        </Border>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Send file..." Width="90" Margin="8,0,0,0" Click="SendFile_Click" />
            <Button DockPanel.Dock="Right" Content="Send" Width="80" Margin="8,0,0,0" IsDefault="True" Click="Send_Click" />
            <CheckBox x:Name="PrivateBox" DockPanel.Dock="Right" Content="only to the selected user" VerticalAlignment="Center" Margin="8,0,0,0" />
            <TextBox x:Name="InputBox" />
        </DockPanel>
        <ProgressBar x:Name="FileProgress" DockPanel.Dock="Bottom" Height="6" Margin="0,6,0,0" Maximum="1" Visibility="Collapsed" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Messages" Margin="0,0,8,0" />
            <GroupBox Header="Online" Grid.Column="1">
                <ListBox x:Name="Users" />
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
