<Window x:Class="Chat.Server.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat server" Height="480" Width="720" Closing="Window_Closing">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="PortBox" Text="5050" Width="70" Margin="0,0,12,0" />
            <TextBlock Text="Users file" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="UsersBox" Text="users.json" Width="200" Margin="0,0,12,0" />
            <Button x:Name="StartButton" Content="Start" Width="80" Click="Start_Click" Margin="0,0,6,0" />
            <Button x:Name="StopButton" Content="Stop" Width="80" Click="Stop_Click" IsEnabled="False" />
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Text="Stopped" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Log" Margin="0,0,8,0">
                <ListBox x:Name="LogList" FontFamily="Consolas" />
            </GroupBox>
            <GroupBox Header="Online" Grid.Column="1">
                <ListBox x:Name="UserList" />
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
